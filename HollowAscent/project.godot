; The Hollow Ascent - standalone original game
config_version=5

[application]
config/name="The Hollow Ascent"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Rise on the edge of an incoming blade. An original ink-painted parry ascent."

[display]
window/size/viewport_width=1080
window/size/viewport_height=720
window/size/window_width_override=1080
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.914, 0.898, 0.851, 1)

[audio]
driver/enable_input=false
